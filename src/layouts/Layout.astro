---
import blobGreen from "../assets/blob-green.svg";
import blobTeal from "../assets/blob-teal.svg";
import Copyright from "../components/copyright.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Dustin Hoeppner Dev</title>
  </head>
  <!-- <nav>
    <ul>
      <li><a href="#hero">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav> -->
  <body>
    <img
      class="blob blob-green"
      src={blobGreen.src}
      alt=""
      fetchpriority="high"
    />
    <img
      class="blob blob-teal"
      src={blobTeal.src}
      alt=""
      fetchpriority="high"
    />
    <div class="snap-container">
      <slot />
      <Copyright />
    </div>
  </body>

  <style is:global>
    html,
    body {
      margin: 0;
      height: 100%;
    }

    body {
      width: 100%;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 300;
      background-color: #222626;
      color: #fff;
    }

    .snap-container {
      height: 100vh;
      height: 100dvh;
      overflow-y: scroll;
      scroll-snap-type: y mandatory;
    }

    section {
      scroll-snap-align: start;
    }

    h1 {
      font-weight: 300;
      font-size: clamp(1.5rem, 5vw, 2rem);
    }

    h2 {
      font-weight: 300;
      font-size: clamp(1rem, 3vw, 1.5rem);
    }

    h3,
    h4,
    h5,
    h6 {
      font-weight: 300;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .blob {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      filter: blur(100px);
      will-change: transform;
      object-fit: cover;
    }

    .blob-green {
      left: -25%;
      animation: drift-green 90s ease-in-out infinite;
    }

    .blob-teal {
      right: -25%;
      left: auto;
      animation: drift-teal 85s ease-in-out infinite; /* offset slightly for asymmetrical look */
    }

    @keyframes drift-green {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(75%);
      }
    }

    @keyframes drift-teal {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(-75%);
      }
    }
  </style>
</html>
