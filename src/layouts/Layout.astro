---
import blobGreen from "../assets/blob-green.svg";
import blobTeal from "../assets/blob-teal.svg";
import Copyright from "../components/copyright.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  snap?: boolean;
}

const {
  title = "Dustin Hoeppner Dev",
  description = "IT professional transitioning to software development. Portfolio featuring procedural CSS animations and full-stack projects.",
  snap = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph / Social Media Preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dhoepp.com/og-image.png" />
    <meta property="og:url" content="https://dhoepp.com" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card (uses same image) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://dhoepp.com/og-image.png" />
  </head>
  <body>
    <Nav />
    <img
      class="blob blob-green"
      src={blobGreen.src}
      alt=""
      fetchpriority="high"
    />
    <img
      class="blob blob-teal"
      src={blobTeal.src}
      alt=""
      fetchpriority="high"
    />
    <div class:list={[snap ? "snap-container" : "page-container"]}>
      <slot />
      <Copyright />
    </div>
  </body>

  <style is:global>
    html,
    body {
      margin: 0;
      height: 100%;
    }

    body {
      width: 100%;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 300;
      background-color: #222626;
      color: #fff;
    }

    .snap-container {
      height: 100vh;
      height: 100dvh;
      overflow-y: scroll;
      scroll-snap-type: y mandatory;
    }

    .page-container {
      min-height: 100dvh;
    }

    section {
      scroll-snap-align: start;
    }

    h1 {
      font-weight: 300;
      font-size: clamp(1.5rem, 5vw, 2rem);
    }

    h2 {
      font-weight: 300;
      font-size: clamp(1rem, 3vw, 1.5rem);
      text-align: center;
    }

    h3,
    h4,
    h5,
    h6 {
      font-weight: 300;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .blob {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      z-index: -1;
      filter: blur(100px);
      will-change: transform;
      object-fit: cover;
    }

    .blob-green {
      left: -25%;
      animation: drift-green 90s ease-in-out infinite;
    }

    .blob-teal {
      right: -25%;
      left: auto;
      animation: drift-teal 85s ease-in-out infinite; /* offset slightly for asymmetrical look */
    }

    @keyframes drift-green {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(75%);
      }
    }

    @keyframes drift-teal {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(-75%);
      }
    }
  </style>
</html>
