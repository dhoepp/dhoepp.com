---
const { title, description, tech, github, demo } = Astro.props;
---

<div class="project-card">
  <h3>{title}</h3>
  <p>{description}</p>
  <p class="tech-stack">{tech.join(" • ")}</p>
  <div class="card-links">
    {github && <a href={github} class="card-btn">GitHub</a>}
    {demo && <a href={demo} class="card-btn">Demo</a>}
  </div>
</div>

<style>
  .project-card {
    flex: 1 1 calc(33.333% - 1.5rem);
    min-width: 280px;
    max-width: 400px;
    padding: 1.5rem;
    border-radius: 12px;
    background: rgba(9, 84, 68, 0.15);
    border: 1px solid rgba(9, 82, 84, 0.4);
    box-shadow:
      /* inner glow */
      inset 0 0 20px rgba(1, 77, 92, 0.2),
      /* outer glow */ 0 0 15px rgba(9, 84, 68, 0.25),
      /* subtle lift for 2.5D */ 0 4px 12px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 0 25px rgba(1, 77, 92, 0.3),
      0 0 25px rgba(9, 84, 68, 0.35),
      0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .project-card h3 {
    margin: 0 0 0.75rem;
  }

  .project-card p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    opacity: 0.85;
  }

  .tech-stack {
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    opacity: 1;
    margin-bottom: 1.25rem;
  }

  .card-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .card-btn {
    color: rgba(100, 220, 200, 0.9);
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(100, 220, 200, 0.25);
    border-radius: 6px;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .card-btn:hover {
    border-color: rgba(100, 220, 200, 0.5);
    background: rgba(100, 220, 200, 0.08);
    text-decoration: none;
  }
</style>
