---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a class="post-card" href={`/writing/${post.id}`}>
  {post.data.draft && <span class="draft-badge">Draft</span>}
  <h3>{post.data.title}</h3>
  <p class="post-date">{formattedDate}</p>
  <p class="post-desc">{post.data.description}</p>
</a>

<style>
  .post-card {
    display: block;
    padding: 1.5rem;
    border-radius: 12px;
    background: rgba(9, 84, 68, 0.15);
    border: 1px solid rgba(9, 82, 84, 0.4);
    box-shadow:
      inset 0 0 20px rgba(1, 77, 92, 0.2),
      0 0 15px rgba(9, 84, 68, 0.25),
      0 4px 12px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
    text-decoration: none;
  }

  .post-card:hover {
    transform: translateY(-1px);
    text-decoration: none;
    box-shadow:
      inset 0 0 25px rgba(1, 77, 92, 0.3),
      0 0 25px rgba(9, 84, 68, 0.35),
      0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .post-card h3 {
    margin: 0 0 0.35rem;
  }

  .post-date {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .post-desc {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.85;
  }

  .draft-badge {
    float: right;
    font-size: 0.7rem;
    color: rgba(100, 220, 200, 0.9);
    border: 1px solid rgba(100, 220, 200, 0.25);
    border-radius: 6px;
    padding: 0.1rem 0.5rem;
  }
</style>
