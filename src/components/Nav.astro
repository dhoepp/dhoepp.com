---
const links = [
  { href: "/", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/#projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/#contact", label: "Contact" },
];
---

<nav class="site-nav">
  <ul>
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: 1rem;
    backdrop-filter: blur(6px);
    background: rgba(34, 38, 38, 0.35);
  }

  .site-nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }

  .site-nav a:hover {
    color: rgba(100, 220, 200, 0.9);
  }

  @media (max-width: 480px) {
    .site-nav ul {
      gap: 1rem;
      font-size: 0.8rem;
    }
  }
</style>
